---
import Section from './Section.astro';
import { skills } from '../data/skills';
import { education } from '../data/experience';
---

<Section id="skills" title="Skills">
  <dl class="grid gap-6 sm:grid-cols-2">
    {
      skills.map((skill) => (
        <div>
          <dt class="text-sm font-medium">{skill.group}</dt>
          <dd class="mt-2 text-[15px] leading-relaxed text-muted">{skill.items.join(' · ')}</dd>
        </div>
      ))
    }
  </dl>
</Section>

<Section id="education" title="Education">
  <ul class="space-y-5">
    {
      education.map((item) => (
        <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <div>
            <p class="font-medium">{item.qualification}</p>
            <p class="text-sm text-muted">{item.institution}</p>
          </div>
          <p class="text-sm text-subtle tabular-nums">{item.year}</p>
        </li>
      ))
    }
  </ul>
</Section>
