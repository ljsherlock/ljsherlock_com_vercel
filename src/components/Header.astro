---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';

const nav = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#work', label: 'Work' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a href="/" class="text-[15px] font-semibold tracking-tight">{profile.name}</a>
    <nav aria-label="Primary" class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-3 py-1.5 text-sm text-muted transition-colors hover:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={profile.cvPath}
        class="ml-2 rounded-full border border-line px-3.5 py-1.5 text-sm font-medium transition-colors hover:border-fg/40"
      >
        CV
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
