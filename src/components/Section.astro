---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="reveal border-t border-line py-16 sm:py-24">
  <div class="grid gap-8 md:grid-cols-[180px_1fr] md:gap-12">
    <h2
      id={`${id}-title`}
      class="text-xs font-medium tracking-[0.18em] text-subtle uppercase md:sticky md:top-24 md:self-start"
    >
      {title}
    </h2>
    <div>
      <slot />
    </div>
  </div>
</section>
