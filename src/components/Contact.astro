---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const links = [
  { href: profile.social.linkedin, label: 'LinkedIn', icon: 'linkedin' as const },
  { href: profile.social.github, label: 'GitHub', icon: 'github' as const },
  { href: profile.cvPath, label: 'CV (PDF)', icon: 'download' as const },
];
---

<section id="contact" aria-labelledby="contact-title" class="reveal border-t border-line py-20 sm:py-28">
  <p class="text-xs font-medium tracking-[0.18em] text-subtle uppercase">Contact</p>
  <h2 id="contact-title" class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
    Building something ambitious? Let’s talk.
  </h2>
  <p class="mt-4 max-w-xl leading-relaxed text-muted">
    I’m open to senior and lead product engineering roles with remote-first teams. The fastest way to reach me is email.
  </p>
  <a
    href={`mailto:${profile.email}`}
    class="link-underline mt-8 inline-block text-xl font-medium tracking-tight sm:text-2xl"
  >
    {profile.email}
  </a>
  <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-fg"
            {...(link.href.startsWith('http') ? { target: '_blank', rel: 'me noopener' } : {})}
          >
            <Icon name={link.icon} />
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
