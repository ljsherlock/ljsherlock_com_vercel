---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { projects } from '../data/projects';
---

<Section id="work" title="Selected work">
  <ul class="grid gap-4">
    {
      projects.map((project) => (
        <li class="group rounded-2xl border border-line p-6 transition-colors hover:border-fg/25 hover:bg-surface/60 sm:p-7">
          <p class="text-xs text-subtle">{project.context}</p>
          <h3 class="mt-2 flex items-center gap-2 text-lg font-semibold tracking-tight">
            {project.url ? (
              <a href={project.url} target="_blank" rel="noopener" class="link-underline">
                {project.title}
              </a>
            ) : (
              project.title
            )}
            {project.url && (
              <Icon
                name="arrow"
                class="size-4 text-subtle transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            )}
          </h3>
          <p class="mt-3 leading-relaxed text-muted">{project.summary}</p>
          <p class="mt-4 text-sm font-medium">
            <span class="text-accent">Outcome — </span>
            {project.outcome}
          </p>
          <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
            {project.tags.map((tag) => (
              <li class="rounded-full bg-surface px-2.5 py-1 text-xs text-muted">{tag}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>
