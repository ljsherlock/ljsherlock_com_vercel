---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import headshot from '../assets/headshot.jpg';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article' | 'profile';
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.tagline,
  type = 'profile',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: headshot, width: 1200, height: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: profile.siteUrl,
  email: `mailto:${profile.email}`,
  image: ogImageUrl.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Bangkok', addressCountry: 'TH' },
  sameAs: [profile.social.linkedin, profile.social.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151519" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`Portrait of ${profile.name}`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const stored = sessionStorage.getItem('theme');
        root.classList.toggle('dark', stored ? stored === 'dark' : media.matches);
        media.addEventListener('change', (event) => {
          sessionStorage.removeItem('theme');
          root.classList.toggle('dark', event.matches);
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-fg focus:px-4 focus:py-2 focus:text-bg"
    >
      Skip to content
    </a>
    <slot />
    <Analytics />
  </body>
</html>
